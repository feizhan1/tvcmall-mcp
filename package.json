{
  "name": "@tvcmall/mcp",
  "version": "0.1.0",
  "description": "TVCMall remote Streamable HTTP MCP server for read-only queries through the PAT-authenticated TVCMall WebApi.",
  "type": "module",
  "bin": {
    "tvcmall-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:local": "node --env-file=.env.local --import tsx src/index.ts",
    "start:local": "node --env-file=.env.local dist/index.js"
  },
  "keywords": [
    "tvcmall",
    "mcp",
    "model-context-protocol"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "keytar": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
